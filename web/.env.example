# Copy to .env.local and fill in. Guide: docs/ENV_SETUP.md
# Leave Supabase empty to run the dashboard on demo data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only — never expose to the browser
SUPABASE_SECRET_KEY=

# EZVIZ Open Platform (open.ezviz.com › My Application)
EZVIZ_APP_KEY=
EZVIZ_APP_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000
