# Supabase (Project Settings › API). Leave empty to run the dashboard on demo data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only — never expose to the browser
SUPABASE_SECRET_KEY=

# EZVIZ Open Platform (open.ezviz.com › My application)
EZVIZ_APP_KEY=
EZVIZ_APP_SECRET=
